# ============================================
# Production Environment Configuration (template)
#
# Copy this file to `.env.production` and fill in the real values.
# `.env.production` is gitignored — never commit real secrets.
# ============================================

# API Configuration - Production Backend
NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_UPLOADS_BASE_URL=https://api.example.com

# Domain Configuration
NEXT_PUBLIC_MAIN_DOMAIN=example.com

# Payload Encryption — must match backend PAYLOAD_ENCRYPTION_KEY
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXT_PUBLIC_PAYLOAD_ENCRYPTION_KEY=__SET_ME__

# Google OAuth (this is a public client id, not a secret)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=__SET_ME__

# Disable Electron features in production web build
ELECTRON_CLIENT_ONLY=false
ELECTRON_IS_DEV=false
